<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvBuddyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buddy_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="32dp" />

        <!-- Stage icon (emoji) -->
        <TextView
            android:id="@+id/tvBuddyIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🥚"
            android:textSize="80sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyTitle"
            android:layout_marginTop="16dp" />

        <!-- Buddy name -->
        <TextView
            android:id="@+id/tvBuddyName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyIcon"
            android:layout_marginTop="8dp" />

        <!-- Stage label -->
        <TextView
            android:id="@+id/tvBuddyStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Egg"
            android:textSize="14sp"
            android:textColor="@color/eco_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyName"
            android:layout_marginTop="4dp" />

        <!-- HP bar -->
        <TextView
            android:id="@+id/tvBuddyHp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HP: 100"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyStage"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvBuddyAge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Age: 0 days"
            android:textSize="14sp"
            android:textColor="@color/eco_green"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyStage"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="22dp" />

        <ProgressBar
            android:id="@+id/pbBuddyHp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="24dp"
            android:max="100"
            android:progress="100"
            android:progressTint="@color/eco_green"
            android:progressBackgroundTint="#E0E0E0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyHp"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <!-- Weather card -->
        <TextView
            android:id="@+id/tvBuddyWeatherLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buddy_weather_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pbBuddyHp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvBuddyWeather"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/weather_loading"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:padding="12dp"
            android:background="#E8F5E9"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyWeatherLabel"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <!-- Recommendations card -->
        <TextView
            android:id="@+id/tvBuddyRecLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buddy_rec_label"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyWeather"
            android:layout_marginStart="32dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/tvBuddyRecommendations"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/rec_all_good"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:padding="12dp"
            android:background="#FFF3E0"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyRecLabel"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <Button
            android:id="@+id/btnBuddyBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="@color/eco_green"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/tvBuddyRecommendations"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
