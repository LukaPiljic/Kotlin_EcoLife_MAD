<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background"
    tools:context=".ThirdActivity">

    <TextView
        android:id="@+id/tvThirdTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/coordinate_detail_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/eco_green_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="64dp" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardCoordinate"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvThirdTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp">

        <TextView
            android:id="@+id/labelTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_timestamp"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <TextView
            android:id="@+id/tvTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelTimestamp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/labelLatitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_latitude"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintTop_toBottomOf="@id/tvTimestamp"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLatitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelLatitude"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/labelLongitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_longitude"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintTop_toBottomOf="@id/tvLatitude"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvLongitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelLongitude"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/labelAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_altitude"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintTop_toBottomOf="@id/tvLongitude"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvAltitude"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="@color/black"
            app:layout_constraintTop_toBottomOf="@id/labelAltitude"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="4dp"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <Button
        android:id="@+id/btnBackToLog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_back"
        android:backgroundTint="@color/eco_green"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardCoordinate"
        android:layout_marginTop="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
