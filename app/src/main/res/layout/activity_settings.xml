<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eco_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvSettingsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/eco_green_dark"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="56dp" />

        <TextView
            android:id="@+id/labelNickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_nickname_label"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSettingsTitle"
            android:layout_marginStart="32dp"
            android:layout_marginTop="40dp" />

        <TextView
            android:id="@+id/tvCurrentNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/no_nickname"
            android:textSize="16sp"
            android:textColor="@color/eco_green_dark"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelNickname"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <TextView
            android:id="@+id/labelObsCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_observation_count_label"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCurrentNickname"
            android:layout_marginStart="32dp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvObsCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="16sp"
            android:textColor="@color/eco_green_dark"
            android:padding="12dp"
            android:background="#FFFFFF"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelObsCount"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <Button
            android:id="@+id/btnChangeNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_change_nickname"
            android:backgroundTint="@color/eco_green"
            android:layout_marginTop="24dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvObsCount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btnResetNickname" />

        <Button
            android:id="@+id/btnResetNickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/btn_reset_nickname"
            android:backgroundTint="@color/eco_green_dark"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvObsCount"
            app:layout_constraintStart_toEndOf="@id/btnChangeNickname"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- API Key section -->
        <TextView
            android:id="@+id/labelApiKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_api_key_label"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnChangeNickname"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/settings_api_key_hint"
            android:inputType="textPassword"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/labelApiKey"
            android:layout_marginTop="6dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp" />

        <Button
            android:id="@+id/btnSaveApiKey"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_save_api_key"
            android:backgroundTint="@color/eco_green"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/etApiKey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSettingsBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="@color/eco_green"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnSaveApiKey"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
